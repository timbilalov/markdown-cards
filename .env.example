# Private login credentials. npm run generate-password prints a password and bcrypt hash.
# For this file use its "Local .env" line (escape $ as \$ to prevent Vite expansion).
# For deployment environment variables use the raw hash without backslashes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Private signing key for login and all authenticated requests. No usable default.
# Generate independently: node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
# Set the same 64-hex-character key on every server instance; never use VITE_/PUBLIC_.
# Changing the key invalidates existing sessions. See README.
SESSION_SECRET=

# Private storage connections. Keep credentials server-only: no VITE_/PUBLIC_ prefixes.
# CLOUD_STORAGE_ACTIVE selects an ID from the JSON array. Restart/redeploy after changes.
# See docs/storages.md for Yandex Disk and Dropbox setup.
CLOUD_STORAGES='[{"id":"disk","label":"Яндекс Диск","provider":"yandex","accessToken":"your_yandex_disk_oauth_token_here","rootPath":"md-cards"},{"id":"dropbox","label":"Dropbox","provider":"dropbox","appKey":"your_dropbox_app_key_here","appSecret":"your_dropbox_app_secret_here","refreshToken":"your_dropbox_refresh_token_here","rootPath":""}]'
CLOUD_STORAGE_ACTIVE=disk
