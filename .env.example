# Private login credentials. npm run generate-password prints a password and bcrypt hash.
# For this file use its "Local .env" line (escape $ as \$ to prevent Vite expansion).
# For deployment environment variables use the raw hash without backslashes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Private signing key for login and all authenticated requests. No usable default.
# Generate independently: node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
# Set the same 64-hex-character key on every server instance; never use VITE_/PUBLIC_.
# Changing the key invalidates existing sessions. See README.
SESSION_SECRET=

# Private configuration for listings, downloads and /api/cloud/upload (Save).
# Editor, board, reads and Save use this configuration through the server session.
# Keep these variables server-only; never add VITE_/PUBLIC_ prefixes.
# Obtain the cloud token from https://oauth.yandex.ru/
CLOUD_STORAGE_PROVIDER=yandex
YANDEX_DISK_TOKEN=your_yandex_disk_oauth_token_here
YANDEX_DISK_BASE_PATH=md-cards
