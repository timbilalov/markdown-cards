{
	"name": "md-cards-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"packageManager": "npm@11.19.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run --exclude \"src/lib/tests/*.production.test.ts\"",
		"test:production": "node scripts/runProductionTests.js",
		"test:production:vercel": "PRODUCTION_TEST_TARGET=vercel vitest run src/lib/tests/*.production.test.ts",
		"test:production:netlify": "PRODUCTION_TEST_TARGET=netlify vitest run src/lib/tests/*.production.test.ts",
		"validate": "npm run check && npm run test:run && npm run test:production && npm run build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate-password": "node scripts/generatePasswordHash.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.13.6",
		"@vitest/ui": "^5.0.1",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "6.7.2",
		"bcryptjs": "^3.0.3",
		"bulma": "1.0.4",
		"dompurify": "^3.4.16",
		"marked": "^18.0.14"
	}
}
